{
  "name": "servicepro-os-enterprise-workspace",
  "private": true,
  "version": "2.0.0",
  "description": "ServicePro OS — Enterprise On-Demand Home Services Management & Dispatch Platform",
  "scripts": {
    "dev:server": "npm --prefix server run dev",
    "dev:web": "npm --prefix admin_web run dev",
    "build": "npm --prefix server run build && npm --prefix admin_web run build",
    "build:server": "npm --prefix server run build",
    "build:web": "npm --prefix admin_web run build",
    "test": "npm --prefix server test",
    "db:migrate": "npm --prefix server run db:migrate",
    "db:rollback": "npm --prefix server run db:rollback",
    "db:verify": "npm --prefix server run db:verify",
    "seed:demo": "npm --prefix server run seed:demo",
    "seed:prod": "npm --prefix server run seed:prod",
    "validate:migrations": "node scripts/validate_migrations.cjs",
    "validate:mobile": "node scripts/validate_dart_codebase.cjs",
    "validate": "node scripts/validate_migrations.cjs && node scripts/validate_dart_codebase.cjs"
  }
}
