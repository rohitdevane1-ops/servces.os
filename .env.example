# ==============================================================================
# ServicePro OS — Commercial Turnkey Environment Template (.env.example)
# Target Commercial Valuation: $20,000 – $60,000 Acquisition Asset
# ZERO Developer Personal Data — Buyer configures their own business credentials
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE & POSTGIS SPATIAL CONFIGURATION
# ------------------------------------------------------------------------------
POSTGRES_DB=servicepro
POSTGRES_USER=servicepro_admin
POSTGRES_PASSWORD=ReplaceWithStrongPassword2026!
POSTGRES_PORT=5432
DATABASE_URL=postgresql://servicepro_admin:ReplaceWithStrongPassword2026!@localhost:5432/servicepro?sslmode=disable

# ------------------------------------------------------------------------------
# 2. FASTIFY SERVER & SECURITY TOKENS
# ------------------------------------------------------------------------------
PORT=3000
NODE_ENV=production
CORS_ORIGIN=http://localhost:5173,http://localhost:80,https://yourdomain.com
JWT_SECRET=ReplaceWithSecureJwtSecretKeyMin32CharactersLong2026!
JWT_REFRESH_SECRET=ReplaceWithSecureJwtRefreshSecretMin32CharactersLong2026!
BOOTSTRAP_TOKEN=ReplaceWithTurnkeyInstallerBootstrapSecret2026!
REDIS_URL=redis://localhost:6379

# ------------------------------------------------------------------------------
# 3. ADMIN & STAFF WEB PORTAL (admin_web — Vite Client Variables)
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:3000/api/v1
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-public-key

# ------------------------------------------------------------------------------
# 4. CUSTOMER & TECHNICIAN MOBILE APPS (Flutter & Android Jetpack Compose)
# ------------------------------------------------------------------------------
API_BASE_URL=http://localhost:3000/api/v1
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-public-key

# ------------------------------------------------------------------------------
# 5. STRIPE PAYMENT & ESCROW HOLD INTEGRATION
# ------------------------------------------------------------------------------
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# ------------------------------------------------------------------------------
# 6. TWILIO SMS TELEPHONY (DISPATCH ALERTS & OTP)
# ------------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=AC_your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+10000000000

# ------------------------------------------------------------------------------
# 7. TRANSACTIONAL EMAIL (AWS SES / SMTP / RESEND)
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=postmaster@yourdomain.com
SMTP_PASS=your_smtp_password
RESEND_API_KEY=re_your_resend_api_key

# ------------------------------------------------------------------------------
# 8. FIREBASE CLOUD MESSAGING (PUSH NOTIFICATIONS)
# ------------------------------------------------------------------------------
FCM_PROJECT_ID=your-firebase-project-id
FCM_CLIENT_EMAIL=firebase-adminsdk@your-firebase-project-id.iam.gserviceaccount.com
FCM_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour-private-key\n-----END PRIVATE KEY-----\n"

# ------------------------------------------------------------------------------
# 9. ENCRYPTION & BOT PROTECTION CHALLENGE (OWASP Hardening)
# ------------------------------------------------------------------------------
# Generate with: node scripts/generate_secrets.cjs
APP_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
CAPTCHA_ENFORCED=false
CAPTCHA_SECRET_KEY=1x0000000000000000000000000000000AA
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA

