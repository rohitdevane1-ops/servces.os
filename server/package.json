{
  "name": "servicepro-os-backend",
  "version": "1.0.0",
  "type": "module",
  "description": "ServicePro OS — Enterprise Fastify + TypeScript Backend with PostgreSQL & PostGIS",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:migrate": "tsx src/database/migrate.ts up",
    "db:rollback": "tsx src/database/migrate.ts down",
    "db:verify": "tsx src/database/verify.ts",
    "test": "tsx --test tests/**/*.test.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^10.0.2",
    "@fastify/helmet": "^13.0.1",
    "@fastify/jwt": "^9.0.4",
    "@fastify/multipart": "^9.0.3",
    "@fastify/rate-limit": "^10.2.2",
    "@fastify/sensible": "^6.0.3",
    "@fastify/swagger": "^9.4.2",
    "@fastify/swagger-ui": "^5.2.2",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "otplib": "^12.0.1",
    "pg": "^8.13.3",
    "stripe": "^17.7.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.13.10",
    "@types/pg": "^8.11.11",
    "embedded-postgres": "^18.7.0-beta.19",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "yaml": "^2.9.1"
  }
}
