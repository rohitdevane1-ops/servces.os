{
  "name": "servicepro-os-backend",
  "version": "1.0.0",
  "type": "module",
  "description": "ServicePro OS — Enterprise Fastify + TypeScript Backend with PostgreSQL & PostGIS",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:migrate": "node -e \"import('node:fs').then(fs=>import('node:child_process').then(cp=>{const s=fs.existsSync('src/database/migrate.ts')?['--import','tsx','src/database/migrate.ts','up']:['dist/database/migrate.js','up'];process.exit(cp.spawnSync(process.execPath,s,{stdio:'inherit'}).status??1)}))\"",
    "db:rollback": "node -e \"import('node:fs').then(fs=>import('node:child_process').then(cp=>{const s=fs.existsSync('src/database/migrate.ts')?['--import','tsx','src/database/migrate.ts','down']:['dist/database/migrate.js','down'];process.exit(cp.spawnSync(process.execPath,s,{stdio:'inherit'}).status??1)}))\"",
    "db:verify": "node -e \"import('node:fs').then(fs=>import('node:child_process').then(cp=>{const s=fs.existsSync('src/database/verify.ts')?['--import','tsx','src/database/verify.ts']:['dist/database/verify.js'];process.exit(cp.spawnSync(process.execPath,s,{stdio:'inherit'}).status??1)}))\"",
    "seed:demo": "node -e \"import('node:fs').then(fs=>import('node:child_process').then(cp=>{const s=fs.existsSync('src/database/seed-demo.ts')?['--import','tsx','src/database/seed-demo.ts']:['dist/database/seed-demo.js'];process.exit(cp.spawnSync(process.execPath,s,{stdio:'inherit'}).status??1)}))\"",
    "seed:prod": "node -e \"import('node:fs').then(fs=>import('node:child_process').then(cp=>{const s=fs.existsSync('src/database/seed-production.ts')?['--import','tsx','src/database/seed-production.ts']:['dist/database/seed-production.js'];process.exit(cp.spawnSync(process.execPath,s,{stdio:'inherit'}).status??1)}))\"",
    "test": "node -e \"process.env.NODE_ENV='test'; import('node:child_process').then(m => { const r = m.spawnSync(process.execPath, ['--import', 'tsx', '--test', 'tests/**/*.test.ts'], { stdio: 'inherit', env: { ...process.env, NODE_ENV: 'test' } }); process.exit(r.status ?? 1); })\""
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^10.0.2",
    "@fastify/helmet": "^13.0.1",
    "@fastify/multipart": "^9.0.3",
    "@fastify/rate-limit": "^10.2.2",
    "@fastify/sensible": "^6.0.3",
    "@fastify/swagger": "^9.4.2",
    "@fastify/swagger-ui": "^6.1.4",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "fastify-plugin": "^5.0.1",
    "jsonwebtoken": "^9.0.3",
    "otplib": "^12.0.1",
    "pg": "^8.13.3",
    "stripe": "^17.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.13.10",
    "@types/pg": "^8.11.11",
    "embedded-postgres": "^18.7.0-beta.19",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "yaml": "^2.9.1"
  }
}
